{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/discovery?kind=sitemap" },
    { "source": "/robots.txt", "destination": "/api/discovery?kind=robots" },
    { "source": "/llms.txt", "destination": "/api/discovery?kind=llms" },
    { "source": "/s/:id", "destination": "/api/share?id=:id" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "crons": [
    { "path": "/api/synthesis", "schedule": "0 14 * * 1" },
    { "path": "/api/maintenance?check=cron_tick", "schedule": "0 13 * * *" }
  ]
}
