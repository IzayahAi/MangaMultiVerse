# ── MangaVerse local dev environment ─────────────────────────────
# Rename this file to .env.local and fill in your values.
# .env.local is git-ignored so your keys stay private.
# Run local dev with `vercel dev` (NOT `npm run dev`) so the /api/* proxy functions are served.

# ── Client (exposed to the browser bundle — must be public/safe) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional client flags:
# VITE_RELEASE_MODE=false   # true = enforce auth + credits (launch); unset/false = demo
# VITE_HAS_ELEVEN=true      # show the voice UI

# ── Server only (used by /api/* functions — NEVER prefixed VITE_, never in the bundle) ──
ANTHROPIC_API_KEY=your-anthropic-key
FAL_KEY=your-fal-key
TOGETHER_API_KEY=your-together-key
ELEVENLABS_KEY=your-elevenlabs-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# RELEASE_MODE=true         # server-side launch gate: require a signed-in JWT + charge credits
